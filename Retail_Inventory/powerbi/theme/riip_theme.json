{
  "name": "RIIP Executive Theme",
  "dataColors": [
    "#1F3864", "#2C8C99", "#E0A458", "#7E8CA0",
    "#6D5C7E", "#6FA287", "#C9705B", "#4A6FA5"
  ],
  "foreground": "#1B2430",
  "foregroundNeutralSecondary": "#6B7684",
  "background": "#FFFFFF",
  "backgroundLight": "#EDF0F4",
  "backgroundNeutral": "#E3E8EF",
  "tableAccent": "#2C8C99",
  "good": "#3E8E5A",
  "neutral": "#E0A458",
  "bad": "#C0554A",
  "maximum": "#1F3864",
  "center": "#FFEB84",
  "minimum": "#C0554A",
  "textClasses": {
    "title":    { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F3864" },
    "header":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F3864" },
    "callout":  { "fontFace": "Segoe UI Bold",     "fontSize": 28, "color": "#1F3864" },
    "label":    { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#6B7684" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E8EF" } }, "radius": 8 }],
        "visualHeaderTooltip": [{ "text": "" }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F3864" } }, "fontSize": 26 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#6B7684" } }, "fontSize": 10 }]
      }
    }
  }
}
